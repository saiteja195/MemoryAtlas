# live | record | replay (replay = offline, cached responses only)
MEMORYATLAS_LLM_MODE=replay
# Create a key in the Meta Model API dashboard. Never commit it.
MODEL_API_KEY=
# Optional overrides
# META_API_BASE_URL=https://api.meta.ai
# META_MODEL=muse-spark-1.3
# MEMORYATLAS_RUNTIME_CACHE=   # where the app records model responses (default: <db>.llmcache)
# MEMORYATLAS_SECRET=           # keys the HMAC of consent revocation tokens; change it outside a demo

# --- Docker (compose.yaml) ---
# WEB_PORT=8080          # the UI is published on 127.0.0.1:<WEB_PORT> only
# EVAL_LABEL=docker-run  # `make docker-eval` writes eval/results/<EVAL_LABEL>
# EVAL_RUNS=3

# --- Public HTTPS on a VM (docs/DEPLOY.md). Only read by deploy/compose.public.yaml ---------------
# PUBLIC_HOST=mynotes.duckdns.org

# --- Profiles -------------------------------------------------------------------------------------
# MEMORYATLAS_AUTH=on     # on (default): sign-up and private Atlases. off: one shared Atlas, development only
# Names and passcodes of the two published demo profiles (read by scripts/seed_profiles.py only):
# DEMO_STAGED_NAME=
# DEMO_STAGED_PASSCODE=
# DEMO_REAL_NAME=
# DEMO_REAL_PASSCODE=
