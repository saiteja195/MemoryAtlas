# Public HTTPS in front of MemoryAtlas, for a VM with a DuckDNS (or any) name pointing at it.
# Caddy gets and renews the certificate by itself; ports 80 and 443 must reach this machine.
# The app protects its own data: everyone signs up with a name and passcode and sees only their own memories.
{$PUBLIC_HOST} {
	encode gzip

	request_body {
		max_size 100MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		# The camera and microphone are used by this site only.
		Permissions-Policy "camera=(self), microphone=(self)"
	}

	reverse_proxy web:80
}
